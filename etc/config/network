
config interface 'loopback'
	option device 'lo'
	option proto 'static'
	list ipaddr '127.0.0.1/8'

config globals 'globals'
	option dhcp_default_duid '0004e524dd54a2915837bf2f2c7b2cb73ebd'
	option ula_prefix 'fdcf:cac4:9b21::/48'

config device
	option name 'br-lan'
	option type 'bridge'
	list ports 'eth0'

config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	list ipaddr '192.168.1.1/24'
	option ip6assign '60'
	option gateway '192.168.1.2'

config interface 'wan'
	option proto 'dhcp'

